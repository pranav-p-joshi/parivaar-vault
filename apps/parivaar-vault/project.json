{
  "name": "parivaar-vault",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "pv",
  "sourceRoot": "apps/parivaar-vault/src",
  "tags": ["type:app", "platform:mobile", "scope:parivaar-vault"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/parivaar-vault",
        "browser": "apps/parivaar-vault/src/main.ts",
        "tsConfig": "apps/parivaar-vault/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/parivaar-vault/public"
          }
        ],
        "styles": [
          "node_modules/@ionic/angular/css/core.css",
          "node_modules/@ionic/angular/css/normalize.css",
          "node_modules/@ionic/angular/css/structure.css",
          "node_modules/@ionic/angular/css/typography.css",
          "node_modules/@ionic/angular/css/display.css",
          "node_modules/@ionic/angular/css/padding.css",
          "node_modules/@ionic/angular/css/float-elements.css",
          "node_modules/@ionic/angular/css/text-alignment.css",
          "node_modules/@ionic/angular/css/text-transformation.css",
          "node_modules/@ionic/angular/css/flex-utils.css",
          "node_modules/@fontsource/baloo-2/600.css",
          "node_modules/@fontsource/baloo-2/700.css",
          "node_modules/@fontsource/baloo-2/800.css",
          "node_modules/@fontsource/mukta/400.css",
          "node_modules/@fontsource/mukta/500.css",
          "node_modules/@fontsource/mukta/600.css",
          "node_modules/@fontsource/mukta/700.css",
          "node_modules/@fontsource/jetbrains-mono/500.css",
          "node_modules/@fontsource/jetbrains-mono/600.css",
          "apps/parivaar-vault/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1.6mb",
              "maximumError": "3mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "8kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            {
              "replace": "apps/parivaar-vault/src/environments/environment.ts",
              "with": "apps/parivaar-vault/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "parivaar-vault:build:production"
        },
        "development": {
          "buildTarget": "parivaar-vault:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/parivaar-vault/jest.config.cts",
        "tsConfig": "apps/parivaar-vault/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "parivaar-vault:build",
        "staticFilePath": "dist/apps/parivaar-vault/browser",
        "spa": true
      }
    },
    "cap:sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap sync",
        "cwd": "apps/parivaar-vault"
      },
      "dependsOn": ["build"]
    },
    "cap:copy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap copy",
        "cwd": "apps/parivaar-vault"
      },
      "dependsOn": ["build"]
    },
    "cap:add:android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap add android",
        "cwd": "apps/parivaar-vault"
      }
    },
    "cap:add:ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap add ios",
        "cwd": "apps/parivaar-vault"
      }
    },
    "cap:open:android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap open android",
        "cwd": "apps/parivaar-vault"
      }
    },
    "cap:open:ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap open ios",
        "cwd": "apps/parivaar-vault"
      }
    },
    "cap:run:android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap run android",
        "cwd": "apps/parivaar-vault"
      },
      "dependsOn": ["cap:sync"]
    },
    "cap:run:ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap run ios",
        "cwd": "apps/parivaar-vault"
      },
      "dependsOn": ["cap:sync"]
    }
  }
}
